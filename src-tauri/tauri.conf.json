{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daybridge",
  "version": "0.1.0",
  "identifier": "com.daybridge.widget",
  "build": {
    "beforeDevCommand": "pnpm dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "title": "Daybridge",
        "width": 256,
        "height": 58,
        "minWidth": 256,
        "minHeight": 58,
        "maxWidth": 256,
        "maxHeight": 58,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": true,
        "backgroundColor": "#00000000"
      },
      {
        "label": "dashboard",
        "title": "Daybridge 관리",
        "width": 960,
        "height": 760,
        "minWidth": 660,
        "minHeight": 540,
        "resizable": true,
        "alwaysOnTop": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "visible": false,
        "backgroundColor": "#252531"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}
