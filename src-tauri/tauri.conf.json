{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Daybridge",
  "version": "0.1.0",
  "identifier": "com.daybridge.widget",
  "build": {
    "beforeDevCommand": "pnpm dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Daybridge",
        "width": 456,
        "height": 690,
        "minWidth": 330,
        "minHeight": 340,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "backgroundColor": "#00000000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "displayLanguageSelector": true
      }
    }
  }
}
