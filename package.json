{
  "name": "daybridge",
  "version": "0.1.0",
  "private": true,
  "description": "Turn session-selected work into a focused, calendar-aware action list.",
  "type": "module",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:all": "node scripts/dev-all.mjs",
    "bridge": "node scripts/compile-quests.mjs && node scripts/local-bridge.mjs",
    "bridge:inspect": "node --inspect scripts/local-bridge.mjs",
    "diagnose:runtime": "node scripts/inspect-runtime.mjs",
    "package:bridge": "node scripts/package-bridge.mjs",
    "compile": "node scripts/compile-quests.mjs",
    "compile:closeout": "node scripts/compile-quests.mjs --source closeout",
    "test:compiler": "node --test scripts/compile-quests.test.mjs",
    "test": "node scripts/test-all.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "tauri": "tauri",
    "dev:widget": "tauri dev",
    "build:widget": "node scripts/build-widget.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.5",
    "rolldown": "1.2.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "googleapis": "170.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  }
}
